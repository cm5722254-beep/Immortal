<?xml version="1.0" encoding="utf-8"?>
<!-- NAMI ANIME App Icon Background — Black with amber radial glow -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pure black base -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="60">
                <item android:offset="0.0" android:color="#1A1200"/>
                <item android:offset="0.5" android:color="#0F0D00"/>
                <item android:offset="1.0" android:color="#0A0A0F"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle amber inner glow -->
    <path
        android:pathData="M54,54m-32,0a32,32 0,1 1,64 0a32,32 0,1 1,-64 0"
        android:fillColor="#00000000"
        android:strokeColor="#FBBF24"
        android:strokeWidth="0.5"
        android:strokeAlpha="0.2"/>

    <!-- Corner star sparks — top left -->
    <path
        android:fillColor="#FBBF24"
        android:fillAlpha="0.4"
        android:pathData="M12,12 L14,10 L16,12 L14,14 Z"/>

    <!-- Corner star sparks — bottom right -->
    <path
        android:fillColor="#FBBF24"
        android:fillAlpha="0.4"
        android:pathData="M94,94 L96,92 L98,94 L96,96 Z"/>

    <!-- Corner star sparks — top right -->
    <path
        android:fillColor="#FBBF24"
        android:fillAlpha="0.25"
        android:pathData="M92,14 L94,12 L96,14 L94,16 Z"/>

    <!-- Thin amber diagonal line - bottom left accent -->
    <path
        android:fillColor="#00000000"
        android:pathData="M8,100 L20,88"
        android:strokeColor="#FBBF24"
        android:strokeWidth="0.6"
        android:strokeAlpha="0.3"/>

    <!-- Thin amber diagonal line - top right accent -->
    <path
        android:fillColor="#00000000"
        android:pathData="M100,8 L88,20"
        android:strokeColor="#FBBF24"
        android:strokeWidth="0.6"
        android:strokeAlpha="0.3"/>

</vector>
