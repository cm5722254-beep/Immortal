<?xml version="1.0" encoding="utf-8"?>
<!-- NAMI ANIME Splash Screen — Vector XML (scales perfectly on all screen sizes) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solid black background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0F"/>
        </shape>
    </item>

    <!-- Centered NAMI ANIME logo icon (from mipmap) -->
    <item
        android:gravity="center"
        android:bottom="120dp">
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher"/>
    </item>

    <!-- App name text: "NAMI ANIME" drawn via a wide amber bar below icon -->
    <item
        android:gravity="center_horizontal|bottom"
        android:bottom="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <size android:height="2dp" android:width="60dp"/>
        </shape>
    </item>

    <!-- Thin amber underline accent at bottom center -->
    <item
        android:gravity="center_horizontal|bottom"
        android:bottom="72dp">
        <shape android:shape="rectangle">
            <solid android:color="#FBBF24"/>
            <size android:height="2dp" android:width="80dp"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>

</layer-list>
